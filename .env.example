# ===========================================
# 学科知识整合智能体 - 环境变量配置示例
# 复制此文件为 .env 并填入真实值
# ===========================================

# ---------- LLM API 配置 ----------
# 只需填写当前 LLM_PROVIDER 对应的那个 Key
# 通义千问 API
DASHSCOPE_API_KEY=your-dashscope-api-key-here

# DeepSeek API
DEEPSEEK_API_KEY=your-deepseek-api-key-here

# OpenAI API
OPENAI_API_KEY=your-openai-api-key-here

# Claude API（需官方 SDK，当前版本仅支持 OpenAI 兼容接口，留空即可）
ANTHROPIC_API_KEY=

# ---------- LLM 行为 ----------
# 可选: dashscope | deepseek | openai（anthropic 暂未接入）
LLM_PROVIDER=deepseek
# 留空则使用提供商默认模型（deepseek-chat / qwen-plus / gpt-4o-mini）
LLM_MODEL=
LLM_TIMEOUT=90
# 额外重试次数（实际请求次数 = 该值 + 1）
LLM_MAX_RETRIES=3
# 同时并发的大模型请求数上限
LLM_CONCURRENCY=4

# ---------- Embedding 模型配置 ----------
# auto: 优先 sentence-transformers，模型不可用时自动降级为 hashing
# 可选: auto | sentence-transformers | hashing
EMBEDDING_BACKEND=auto
EMBEDDING_MODEL=paraphrase-multilingual-MiniLM-L12-v2
# hashing 降级后端的向量维度
EMBEDDING_DIM=384
# 离线环境跳过 HuggingFace 网络探测，直接使用本地缓存/降级方案
EMBEDDING_OFFLINE=true

# ---------- 向量数据库配置 ----------
# 向量库根目录（其下按索引名分目录，例如 default/vectors.npy）
VECTOR_DB=faiss
VECTOR_DB_PATH=data/vectorstore

# ---------- 服务配置 ----------
HOST=0.0.0.0
PORT=8001
ENVIRONMENT=development
DEBUG=true
DATA_DIR=data

# ---------- 上传限制 ----------
MAX_UPLOAD_SIZE_MB=200
# 逗号分隔或 JSON 数组均可
ALLOWED_EXTENSIONS=pdf,md,txt,docx,xlsx

# ---------- CORS 配置 ----------
CORS_ORIGINS=http://localhost:3000,http://localhost:5173,http://localhost:5174

# ---------- 知识点抽取 ----------
# 单个抽取请求的最大字符数，超长章节会被切分后并发抽取
EXTRACTION_MAX_CHARS=6000
# 抽取到的知识点少于该数量视为失败
EXTRACTION_MIN_NODES=1

# ---------- 语义对齐 ----------
# 进入候选对的嵌入相似度阈值
ALIGNMENT_THRESHOLD=0.72
# 达到该相似度直接判定等价，无需 LLM 复核
ALIGNMENT_HIGH_CONFIDENCE=0.88
# 是否用 LLM 复核灰区候选对（较慢，默认关闭）
ALIGNMENT_USE_LLM=false
ALIGNMENT_LLM_MAX_PAIRS=50

# ---------- 压缩比控制 ----------
# 压缩比 = 整合后字数 / 原始总字数，赛题要求 <= 0.30
MAX_COMPRESSION_RATIO=0.30
# 是否允许通过抽取式摘要压缩知识点描述
COMPRESSION_CONDENSE=true
# 描述短于该字数视为已足够精炼，不做摘要
COMPRESSION_MIN_KEEP_CHARS=60
COMPRESSION_MIN_DEFINITION_CHARS=30

# ---------- RAG 配置 ----------
CHUNK_SIZE=600
CHUNK_OVERLAP=100
# 最终参与生成的知识片段数
TOP_K=5
# 召回候选数量（先多召回，再阈值过滤/去重）
RAG_RECALL_K=20
# 相关性下限；留空按嵌入后端自动选择（语义模型 0.35 / hashing 0.18）
RAG_MIN_SCORE=
# 自适应阈值：不低于最高分 × 该比例
RAG_RELATIVE_SCORE_RATIO=0.45
# 拼进 Prompt 的上下文总字数上限
RAG_MAX_CONTEXT_CHARS=6000
# 同一本教材最多使用的片段数，保证来源多样性
RAG_MAX_CHUNKS_PER_TEXTBOOK=3
